@model IEnumerable<WebMensajeria.Modelos.ParticipanteChat>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.idChat)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.idUsuario)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.idRol)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.chats)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.usuarios)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.roles)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.idChat)
            </td>
            <td>
                @Html.DisplayFor(model => item.idUsuario)
            </td>
            <td>
                @Html.DisplayFor(model => item.idRol)
            </td>
            <td>
                @Html.DisplayFor(model => item.chats)
            </td>
            <td>
                @Html.DisplayFor(model => item.usuarios)
            </td>
            <td>
                @Html.DisplayFor(model => item.roles)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.idParticipante">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.idParticipante">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.idParticipante">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
