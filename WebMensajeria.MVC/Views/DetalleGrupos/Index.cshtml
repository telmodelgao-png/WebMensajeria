@model IEnumerable<WebMensajeria.Modelos.DetalleGrupo>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.nombreGrupo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.descripcion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.idChat)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.chats)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.nombreGrupo)
            </td>
            <td>
                @Html.DisplayFor(model => item.descripcion)
            </td>
            <td>
                @Html.DisplayFor(model => item.idChat)
            </td>
            <td>
                @Html.DisplayFor(model => item.chats)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.idDetalleGrupo">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.idDetalleGrupo">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.idDetalleGrupo">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
