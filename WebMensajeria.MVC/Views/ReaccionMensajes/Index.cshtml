@model IEnumerable<WebMensajeria.Modelos.ReaccionMensaje>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.idMensaje)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.idUsuario)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.idTipoReaccion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.mensajes)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.usuario)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TipoReaccion)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.idMensaje)
            </td>
            <td>
                @Html.DisplayFor(model => item.idUsuario)
            </td>
            <td>
                @Html.DisplayFor(model => item.idTipoReaccion)
            </td>
            <td>
                @Html.DisplayFor(model => item.mensajes)
            </td>
            <td>
                @Html.DisplayFor(model => item.usuario)
            </td>
            <td>
                @Html.DisplayFor(model => item.TipoReaccion)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.idReaccion">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.idReaccion">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.idReaccion">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
